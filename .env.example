# TEMPLATE ONLY: replace every replace-with-* value in your private .env.
# Never commit .env. The application and CLI scripts both read the root .env.

# Required: use the same user, password and database as your PostgreSQL instance.
# URL-encode the password in this URL if it contains reserved characters.
DATABASE_URL=postgresql://replace-with-database-user:replace-with-url-encoded-database-password@localhost:5434/replace-with-database-name

# Required in production; recommended locally. Generate a random secret of 32+
# characters with the command in README.md. Do not use this placeholder.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required only for the bundled Docker Compose database.
# POSTGRES_PASSWORD uses the raw password, not its URL-encoded representation.
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=replace-with-database-name

# Stable Compose identity for NEW installations. Existing installations must
# retain their original project name to reuse their existing database volume.
COMPOSE_PROJECT_NAME=wazifa

# Required only if you choose to run the development seed on a new database.
SEED_ADMIN_EMAIL=replace-with-admin-email@example.com
SEED_ADMIN_PASSWORD=replace-with-unique-admin-password-at-least-12-characters
SEED_CANDIDATE_PASSWORD=replace-with-unique-candidate-password-at-least-8-characters

# Optional local settings. Relative upload paths are resolved from this folder.
UPLOAD_DIR=storage/private
COOKIE_SECURE=false
